{
  "id": "feedback",
  "name": "Send Feedback",
  "description": "Share your experience with us",
  "icon": "star",
  "category": "engagement",
  "active": false,
  "version": 1,
  "bar_button_label": "Feedback",
  "fields": [
    {
      "name": "name",
      "type": "text",
      "label": "Name",
      "placeholder": "Your name (optional)",
      "required": false,
      "max_length": 100
    },
    {
      "name": "email",
      "type": "email",
      "label": "Email",
      "placeholder": "you@example.com (optional)",
      "required": false
    },
    {
      "name": "rating",
      "type": "radio",
      "label": "Rating",
      "required": true,
      "options": ["Excellent", "Good", "Average", "Poor"]
    },
    {
      "name": "feedback",
      "type": "textarea",
      "label": "Feedback",
      "placeholder": "Tell us what you think...",
      "required": true,
      "max_length": 2000
    }
  ],
  "constraints": {
    "capacity": {
      "enabled": false
    },
    "uniqueness": {
      "enabled": false
    },
    "operating_hours": {
      "enabled": false
    }
  },
  "confirmation": {
    "auto_confirm": true,
    "default_status": "confirmed",
    "code_length": 6,
    "code_alphabet": "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
  },
  "responses": {
    "success": "Thank you for your feedback! Reference: {confirmation_code}.",
    "cancelled": "Feedback {confirmation_code} has been withdrawn."
  },
  "companion_tools": {
    "check_availability": false,
    "cancel_by_code": false
  },
  "notifications": {
    "guest_email_field": "email",
    "owner_notify": true,
    "guest_notify": false
  },
  "rate_limit": {
    "max_per_ip_per_hour": 5,
    "burst_max": 2,
    "burst_window_seconds": 60
  },
  "keep_days": 365
}
